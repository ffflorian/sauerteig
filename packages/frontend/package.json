{
  "author": "Florian Imdahl <git@ffflorian.de>",
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-swipeable": "7.0.2"
  },
  "devDependencies": {
    "@ffflorian/oxlint-config": "1.0.8",
    "@ffflorian/prettier-config": "1.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "~26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-perfectionist": "5.11.0",
    "happy-dom": "20.14.5",
    "jsdom": "30.0.1",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-eslint": "1.8.1",
    "vitest": "5.0.0"
  },
  "name": "sauerteig-frontend",
  "prettier": "@ffflorian/prettier-config",
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "clean": "rm -rf dist",
    "dev": "yarn start",
    "dist": "yarn clean && yarn build",
    "fix": "yarn fix:ts && yarn fix:other",
    "fix:other": "yarn prettier --write",
    "fix:ts": "yarn lint:ts --fix",
    "lint": "yarn lint:other && yarn lint:ts",
    "lint:other": "yarn prettier --check",
    "lint:ts": "oxlint --ignore-path .gitignore .",
    "prettier": "prettier --ignore-path ../../.prettierignore .",
    "start": "vite --open",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "version": "1.0.1"
}
