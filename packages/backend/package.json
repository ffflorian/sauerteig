{
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/schedule": "12.0.1",
    "@nestjs/throttler": "6.5.0",
    "helmet": "8.3.0",
    "mongoose": "9.9.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@ffflorian/oxlint-config": "1.0.8",
    "@ffflorian/prettier-config": "1.0.1",
    "@types/node": "~26",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "files": [
    "dist"
  ],
  "name": "sauerteig-backend",
  "prettier": "@ffflorian/prettier-config",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "IS_LOCAL=true yarn start",
    "dist": "yarn clean && yarn build",
    "fix": "yarn fix:ts && yarn fix:other",
    "fix:other": "yarn prettier --write",
    "fix:ts": "yarn lint:ts --fix",
    "lint": "yarn lint:other && yarn lint:ts",
    "lint:other": "yarn prettier --check",
    "lint:ts": "oxlint --ignore-path .gitignore .",
    "prettier": "prettier --ignore-path ../../.prettierignore .",
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "version": "1.0.0"
}
